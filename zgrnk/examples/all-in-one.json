{
  "log": {
    "level": "warn"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "awg",
      "address": [
        "10.8.1.2/32"
      ],
      "private_key": "<client-private-key>",
      "mtu": 1280,
      "peers": [
        {
          "address": "vpn.example.com",
          "port": 51820,
          "public_key": "<server-public-key>",
          "pre_shared_key": "<pre-shared-key>",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ],
          "persistent_keepalive_interval": 25
        }
      ],
      "amnezia": {
        "jc": 4,
        "jmin": 40,
        "jmax": 70,
        "s1": 15,
        "s2": 30,
        "s3": 20,
        "s4": 10,
        "h1": 123456701,
        "h2": 123456702,
        "h3": 123456703,
        "h4": 123456704,
        "i1": "<i1-signature-from-server>",
        "random_trailers": true
      }
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "reality-tcp",
      "server": "vpn.example.com",
      "server_port": 443,
      "uuid": "<vless-uuid>",
      "flow": "xtls-rprx-vision",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "<reality-server-name>",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "<reality-public-key>",
          "short_id": "<reality-short-id>"
        }
      }
    },
    {
      "type": "vless",
      "tag": "reality-xhttp",
      "server": "vpn.example.com",
      "server_port": 8443,
      "uuid": "<vless-uuid>",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "<reality-server-name>",
        "alpn": [
          "h2"
        ],
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "<reality-public-key>",
          "short_id": "<reality-short-id>"
        }
      },
      "transport": {
        "type": "xhttp",
        "mode": "stream-one",
        "host": "<reality-server-name>",
        "path": "/<xhttp-path>",
        "x_padding_bytes": "100-1000"
      }
    },
    {
      "type": "naive",
      "tag": "naive",
      "server": "naive.example.com",
      "server_port": 443,
      "username": "<naive-username>",
      "password": "<naive-password>",
      "tls": {
        "enabled": true,
        "server_name": "naive.example.com"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "reality-tcp",
        "naive",
        "reality-xhttp",
        "awg"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 100
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "reality-tcp",
        "reality-xhttp",
        "naive",
        "awg"
      ],
      "default": "auto"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": "local"
  }
}
